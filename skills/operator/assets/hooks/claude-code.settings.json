{
  "_comment": "~/.claude/settings.json 또는 프로젝트 .claude/settings.json 의 hooks 에 합친다. OPERATOR_HOME 을 스킬 폴더 절대경로로.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"OPERATOR_HOME/scripts/op.py\" ] || exit 0; exec python3 -I \"OPERATOR_HOME/scripts/op.py\" guard --format claude"
          }
        ]
      }
    ]
  }
}
